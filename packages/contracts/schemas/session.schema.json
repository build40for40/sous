{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build40for40.com/sous/schemas/session.schema.json",
  "title": "Session",
  "description": "One cook of one recipe: the conversation between the cook and Sous, plus the tool calls Sous made along the way. The $defs also hold the /turns request body and the SSE events it streams back.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "recipe_id", "stage", "started_at", "turns"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "recipe_id": { "type": "string", "minLength": 1 },
    "stage": { "$ref": "#/$defs/Stage" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "turns": {
      "type": "array",
      "items": { "$ref": "#/$defs/Turn" }
    },
    "facts": {
      "description": "Everything Sous saved with the note tool, kept for the post-cook reflection.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rating": {
      "description": "The cook's rating from /end, one to five.",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "notes": {
      "description": "Anything the cook wrote or said at /end.",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "Stage": {
      "description": "Rough stages of a cook, in their usual order. The cook can go off script, so any stage can follow any other.",
      "enum": ["decide", "prep", "cook", "present", "feedback"]
    },
    "Turn": {
      "description": "One entry in the transcript. Cook and tool turns become user messages for Claude; sous turns are assistant messages.",
      "oneOf": [
        { "$ref": "#/$defs/CookTurn" },
        { "$ref": "#/$defs/SousTurn" },
        { "$ref": "#/$defs/ToolTurn" }
      ]
    },
    "CookTurn": {
      "description": "What the cook said, as text from on-device speech to text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "at", "text"],
      "properties": {
        "role": { "const": "cook" },
        "at": { "type": "string", "format": "date-time" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "SousTurn": {
      "description": "Sous's reply: speech-ready text, tool calls, or both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "at"],
      "anyOf": [{ "required": ["text"] }, { "required": ["tool_calls"] }],
      "properties": {
        "role": { "const": "sous" },
        "at": { "type": "string", "format": "date-time" },
        "text": { "type": "string", "minLength": 1 },
        "tool_calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ToolCall" }
        }
      }
    },
    "ToolTurn": {
      "description": "Results for the tool calls in the sous turn before it: from the app for client tools, from the brain for note.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "at", "tool_results"],
      "properties": {
        "role": { "const": "tool" },
        "at": { "type": "string", "format": "date-time" },
        "tool_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ToolResult" }
        }
      }
    },
    "ToolCall": {
      "description": "A tool_use block from Claude. id is Claude's tool_use id; input matches that tool's input_schema in tools.json.",
      "oneOf": [
        { "$ref": "#/$defs/StartTimerCall" },
        { "$ref": "#/$defs/CancelTimerCall" },
        { "$ref": "#/$defs/GoToStepCall" },
        { "$ref": "#/$defs/SetStageCall" },
        { "$ref": "#/$defs/ShowCall" },
        { "$ref": "#/$defs/NoteCall" },
        { "$ref": "#/$defs/AwaitAckCall" }
      ]
    },
    "StartTimerCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "start_timer" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "seconds"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "CancelTimerCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "cancel_timer" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timer_id"],
          "properties": {
            "timer_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "GoToStepCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "go_to_step" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "SetStageCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "set_stage" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage"],
          "properties": {
            "stage": { "$ref": "#/$defs/Stage" }
          }
        }
      }
    },
    "ShowCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "show" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["view"],
          "properties": {
            "view": { "enum": ["step", "ingredients", "done_cue"] }
          }
        }
      }
    },
    "NoteCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "note" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact"],
          "properties": {
            "fact": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "AwaitAckCall": {
      "description": "Run by the brain, which reports it to the app as awaiting_ack on the done event. Kept out of the session's turns.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "const": "await_ack" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short"],
          "properties": {
            "short": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "ToolResult": {
      "description": "Becomes a tool_result block for Claude. start_timer's content is the new timer's id, which cancel_timer takes later.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_call_id", "content"],
      "properties": {
        "tool_call_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "is_error": { "type": "boolean" }
      }
    },
    "TurnRequest": {
      "description": "Body of POST /sessions/:id/turns. Send every result for the last reply's client tool calls together, plus anything the cook said since and anything on the phone that made the flame go red.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["text"] }, { "required": ["tool_results"] }, { "required": ["events"] }],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "tool_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ToolResult" }
        },
        "events": {
          "description": "What happened on the phone that needs the chef, sent with the turn the chef opens after the flame goes red.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/PhoneEvent" }
        }
      }
    },
    "PhoneEvent": {
      "description": "Something on the phone that needs the chef. Sous never speaks first, so the app turns the flame red and reports it with the chef's next turn.",
      "oneOf": [{ "$ref": "#/$defs/TimerFinishedEvent" }]
    },
    "TimerFinishedEvent": {
      "description": "A timer ran out. timer_id is the id the phone returned from start_timer and label is the one Sous gave it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timer_id", "label"],
      "properties": {
        "type": { "const": "timer_finished" },
        "timer_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "StreamEvent": {
      "description": "The data of one SSE event from POST /sessions/:id/turns. The SSE event name equals type.",
      "oneOf": [
        { "$ref": "#/$defs/TextEvent" },
        { "$ref": "#/$defs/ToolCallEvent" },
        { "$ref": "#/$defs/DoneEvent" },
        { "$ref": "#/$defs/ErrorEvent" }
      ]
    },
    "TextEvent": {
      "description": "The next chunk of Sous's reply text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "delta"],
      "properties": {
        "type": { "const": "text" },
        "delta": { "type": "string" }
      }
    },
    "ToolCallEvent": {
      "description": "A client tool for the app to run. note never appears here because the brain runs it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tool_call"],
      "properties": {
        "type": { "const": "tool_call" },
        "tool_call": {
          "oneOf": [
            { "$ref": "#/$defs/StartTimerCall" },
            { "$ref": "#/$defs/CancelTimerCall" },
            { "$ref": "#/$defs/GoToStepCall" },
            { "$ref": "#/$defs/SetStageCall" },
            { "$ref": "#/$defs/ShowCall" }
          ]
        }
      }
    },
    "DoneEvent": {
      "description": "The reply is finished. tool_use means the app owes results for this reply's tool calls in the next TurnRequest. awaiting_ack, only ever with end_turn, means the reply ended with an instruction or offer the chef hasn't acknowledged yet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "stop_reason"],
      "properties": {
        "type": { "const": "done" },
        "stop_reason": { "enum": ["end_turn", "tool_use"] },
        "awaiting_ack": { "$ref": "#/$defs/AwaitingAck" }
      }
    },
    "AwaitingAck": {
      "description": "The instruction waiting for \"Heard\". short is what the app repeats aloud, like an alarm clock, until the chef acknowledges it or opens a new turn.",
      "type": "object",
      "additionalProperties": false,
      "required": ["short"],
      "properties": {
        "short": { "type": "string", "minLength": 1 }
      }
    },
    "ErrorEvent": {
      "description": "The turn failed. The stream ends after this.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
